{
    "openapi": "3.0.1",
    "info": {
        "title": "Participium API",
        "version": "1.0.0",
        "description": "API documentation for Participium application"
    },
    "servers": [
        {
            "url": "http://localhost:3001",
            "description": "Production Server"
        }
    ],
    "tags": [
        {
            "name": "Authentication",
            "description": "Operations for user authentication"
        },
        {
            "name": "Reports",
            "description": "Operations for reports handling"
        },
        {
            "name": "Statistics",
            "description": "Operations for statistics retrieval"
        }
    ],
    "paths": {
        
    },
    "components": {
        "schemas": {
            "user": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "id": { "type": "integer" },
                    "username": { "type": "string" },
                    "email": { "type": "string", "format": "email" },
                    "password": { "type": "string", "minLength": 8, "maxLength": 255 },
                    "firstName": { "type": "string", "minLength": 3, "maxLength": 30 },
                    "lastName": { "type": "string", "minLength": 2, "maxLength": 40},
                    "typeId": { "type": "integer", "minimum": 0  },
                    "allowEmailNotifications": { "type": "integer", "minimum": 0, "maximum": 1, "default": 1 },
                    "telegramUsername": { "type": "string", "minLength": 5, "maxLength": 32  },
                    "imageURL": { "type": "string", "format": "uri" }
                },
                "required": [ "username", "email", "password", "firstName", "lastName", "typeId" ]
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "connect.sid",
                "description": "Session cookie for user authentication"
            }
        }
    }
}